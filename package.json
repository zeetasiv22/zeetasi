{
  "name": "zetahub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "node scripts/bootstrap-admin.mjs && next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node scripts/integration.mjs",
    "db:start": "supabase start -x studio,imgproxy,edge-runtime,logflare,vector,supavisor",
    "db:reset": "supabase db reset",
    "format": "prettier --write src tests scripts docs README.md",
    "test:http": "node scripts/http-smoke.mjs",
    "test:providers:integration": "node scripts/providers.integration.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "latest",
    "@supabase/supabase-js": "2.117.2",
    "dashjs": "^5.2.1",
    "hls.js": "^1.7.3",
    "lucide-react": "latest",
    "next": "16.3.8",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "16.3.8",
    "prettier": "^3.9.9",
    "supabase": "latest",
    "tailwindcss": "4.3.3",
    "typescript": "^5.9.0",
    "vite": "^8.3.3",
    "vitest": "latest"
  },
  "engines": {
    "node": "24.x"
  }
}
