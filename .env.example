# Optional, operator-only initial admin. Clear all three after provisioning.
ZETAHUB_BOOTSTRAP_ADMIN=false
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
# RapidAPI: server-only. Do not prefix the following variables with NEXT_PUBLIC_.
