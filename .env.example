# Comma-separated adapter IDs AFTER real testing and provider terms review.
# Currently implemented: availability (official watch links only).
RAPIDAPI_VERIFIED_PROVIDERS=
RAPIDAPI_COUNTRY=id
# Shared hard cap per provider per calendar month; set <= your subscribed quota.
RAPIDAPI_MONTHLY_BUDGET=1000
